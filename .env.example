# Startech Environment Configuration

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1
REACT_APP_API_TIMEOUT=10000

# Frontend URL
REACT_APP_FRONTEND_URL=http://localhost:3000

# Payment Gateway Keys
REACT_APP_SSLCOMMERZ_STORE_ID=your_store_id
REACT_APP_SSLCOMMERZ_STORE_PASSWORD=your_store_password

# Google Analytics
REACT_APP_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Feature Flags
REACT_APP_ENABLE_MOCK_DATA=true
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_ENABLE_REVIEWS=true
REACT_APP_ENABLE_WISHLIST=true
REACT_APP_ENABLE_COMPARISON=true
REACT_APP_ENABLE_PC_BUILDER=true

# App Configuration
REACT_APP_APP_NAME=Startech
REACT_APP_APP_VERSION=1.0.0
REACT_APP_MAX_CART_ITEMS=50
REACT_APP_MAX_COMPARISON_ITEMS=5
REACT_APP_ITEMS_PER_PAGE=12

# Debug Mode
REACT_APP_DEBUG_MODE=false
REACT_APP_LOG_LEVEL=info
